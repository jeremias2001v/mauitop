rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isPublicOrderCreate() {
      return request.auth == null
        && request.resource.data.keys().hasAll(['cliente', 'estado', 'fecha', 'total'])
        && request.resource.data.estado == 'Pendiente'
        && request.resource.data.fecha == request.time
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
    }

    // Menu publico. El panel admin puede crear, editar y borrar al iniciar sesion.
    match /categorias/{categoriaId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /productos/{productoId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Configuracion real usada por la app: estado, operacion y estrella.
    match /configuracion/{configId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Pedidos web: el cliente los crea sin login. Admin, meseros y cocina los gestionan con login.
    match /pedidos/{pedidoId} {
      allow create: if signedIn() || isPublicOrderCreate();
      allow read, update, delete: if signedIn();
    }

    // Perfiles de meseros creados desde el panel admin y leidos por meseros al iniciar sesion.
    match /meseros/{meseroId} {
      allow read, write: if signedIn();
    }

    // Compatibilidad por si algun documento antiguo usa estas colecciones.
    match /mesas/{mesaId} {
      allow read, write: if signedIn();
    }

    match /pedidos_cocina/{pedidoId} {
      allow read, write: if signedIn();
    }

    match /usuarios/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /inventario/{document=**} {
      allow read, write: if signedIn();
    }

    match /operacion/{document=**} {
      allow read, write: if signedIn();
    }

    match /finanzas/{document=**} {
      allow read, write: if signedIn();
    }

    match /estadisticas/{document=**} {
      allow read, write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
